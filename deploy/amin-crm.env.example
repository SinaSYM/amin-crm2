# Core runtime
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3005
DATABASE_URL=file:/var/lib/amin-crm/custom.db

# Authentication
DEMO_AUTH=0

# Optional AI integration. Leave empty to use the application's fallback mode.
GEMINI_API_KEY=

# Optional reminder worker. Do not enable amin-crm-reminder.service until a
# real webhook URL has been configured.
REMINDER_WEBHOOK_URL=
REMINDER_WEBHOOK_METHOD=POST
REMINDER_WEBHOOK_HEADERS='{"Content-Type":"application/json"}'
REMINDER_WEBHOOK_PAYLOAD_TEMPLATE='{"recipient_phone":"{recipient_phone}","title":"{title}","due_date":"{due_date}","description":"{description}"}'
REMINDER_POLL_INTERVAL_MS=60000

# Temporary bootstrap values. Add them only while running bootstrap-admin.mjs,
# then remove both values from /etc/amin-crm.env.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-long-random-password
